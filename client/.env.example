# Plain HTTP by default: the API's HTTPS profile uses an untrusted local dev cert, which
# both real browsers and Playwright's Chromium reject without an extra `dotnet dev-certs
# https --trust` step. Point at the https:// profile below instead if you've done that.
VITE_API_BASE_URL=http://localhost:5112
VITE_HUB_URL=http://localhost:5112/hubs/game
